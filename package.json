{
  "name": "biolab-assistant",
  "private": true,
  "version": "1.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:browser": "vite --mode browser",
    "build": "node sync-version.mjs --check && vite build",
    "tauri": "tauri",
    "version:check": "node sync-version.mjs --check",
    "version:sync": "node sync-version.mjs",
    "version:set": "node sync-version.mjs",
    "test:map": "esbuild tests/map-geometry.jsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=.test-map.cjs --log-level=error && node .test-map.cjs",
    "test:mount": "esbuild tests/cloning-mount.jsx --bundle --platform=node --format=esm --jsx=automatic --external:jsdom --alias:@tauri-apps/api/core=./tests/stub-tauri.js --outfile=.test-mount.mjs --log-level=error && node .test-mount.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "html2canvas": "^1.4.1",
    "jsdom": "^31.0.1",
    "katex": "^0.16.47",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.0"
  }
}
